{%- liquid
  assign site_desc = 'Five magnetic cases for 3 ML and 10 ML vials, made to order in 8 colors. Magnets in the base and lid hold the case shut.'
  assign meta_desc = site_desc
  if template.name == 'product'
    assign meta_desc = product.title | append: ' in 8 colors. Magnets in the base and lid hold the case shut. Made to order and shipped within the United States.'
  elsif template.name == 'page' and page.handle == 'fluxcase-3ml-cases'
    assign meta_desc = 'Magnetic cases for 3 ML vials: the 6-vial and 12-vial cases, plus the 7-vial mixed case for 3 ML and 10 ML vials, each in 8 colors.'
  elsif template.name == 'page' and page.handle == 'fluxcase-10ml-cases'
    assign meta_desc = 'Magnetic cases for 10 ML vials: the 4-vial and 8-vial cases, plus the 7-vial mixed case for 3 ML and 10 ML vials, each in 8 colors.'
  elsif template.name == 'page' and page.handle == 'fluxcase-wholesale'
    assign meta_desc = 'Volume orders of Fluxcase magnetic vial cases from 50 cases, in any mix of sizes and colors. Logo branding from 150 cases.'
  elsif template.name == 'page' and page.handle == 'fluxcase-about'
    assign meta_desc = 'Why every Fluxcase has magnets in the base and lid, and how the cases are made to order in 8 colors.'
  elsif template.name == 'page' and page.handle == 'fluxcase-disclaimer'
    assign meta_desc = page_description | default: site_desc
  elsif template.name == 'page' and page.content != blank
    capture raw_desc
      echo page.content
    endcapture
    capture meta_desc
      render 'fc-clean', html: raw_desc
    endcapture
    assign meta_desc = meta_desc | replace: '</h2>', ': ' | replace: '</h3>', ': ' | replace: '</p>', ' ' | replace: '</li>', ' ' | strip_html | strip | truncate: 160
  elsif page_description != blank
    capture raw_desc
      echo page_description | strip_html
    endcapture
    capture meta_desc
      render 'fc-clean', html: raw_desc
    endcapture
    assign meta_desc = meta_desc | strip_html | strip | truncate: 160
  endif
-%}<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#F4F3F0">
<link rel="canonical" href="{{ canonical_url }}">
<title>{% if template.name == 'index' %}Fluxcase | Magnetic vial cases{% else %}{{ page_title }} | Fluxcase{% endif %}</title>
<meta name="description" content="{{ meta_desc | escape }}">
<meta property="og:site_name" content="Fluxcase">
<meta property="og:title" content="{% if template.name == 'index' %}Fluxcase, magnetic vial cases{% else %}{{ page_title | escape }}{% endif %}">
<meta property="og:description" content="{{ meta_desc | escape }}">
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if template.name == 'product' and product.featured_media -%}<meta property="og:image" content="{{ product.featured_media | image_url: width: 1200 }}">{%- endif %}
<link rel="icon" type="image/svg+xml" href="{{ 'fluxcase-favicon.svg' | asset_url }}">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=Schibsted+Grotesk:wght@400;500;600&display=swap">
{{ 'fable2.css' | asset_url | stylesheet_tag }}
{{ 'fc-logo.css' | asset_url | stylesheet_tag }}
{{ 'fc-picker.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body class="tpl-{{ template.name }}">
<a class="skip" href="#main">Skip to content</a>
{%- capture fc_mark -%}{%- render 'fc-logo', word: true -%}{%- endcapture -%}
<header class="hd"><div class="wrap hd-row">
  <a class="mark" href="{{ routes.root_url }}" aria-label="Fluxcase home">{{ fc_mark }}</a>
  <nav class="nav" id="siteNav" aria-label="Main">
    <a href="/pages/fluxcase-3ml-cases"{% if page.handle == 'fluxcase-3ml-cases' %} aria-current="page"{% endif %}>3&nbsp;ML cases</a>
    <a href="/pages/fluxcase-10ml-cases"{% if page.handle == 'fluxcase-10ml-cases' %} aria-current="page"{% endif %}>10&nbsp;ML cases</a>
    <a href="/pages/fluxcase-wholesale"{% if page.handle == 'fluxcase-wholesale' %} aria-current="page"{% endif %}>Wholesale</a>
    <a href="/pages/fluxcase-about"{% if page.handle == 'fluxcase-about' %} aria-current="page"{% endif %}>About</a>
  </nav>
  <div class="hd-end">
    <a class="cartlink" href="{{ routes.cart_url }}"{% if template.name == 'cart' %} aria-current="page"{% endif %}>Cart<span class="cart-sr visually-hidden">, </span><span class="n" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span><span class="cart-sr visually-hidden"> items in cart</span></a>
    <button class="navbtn" type="button" data-nav-toggle aria-expanded="false" aria-controls="siteNav">
      <svg class="ic-m" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5.5h14M3 10h14M3 14.5h14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <svg class="ic-x" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <span>Menu</span>
    </button>
  </div>
</div></header>
<main id="main" tabindex="-1">
{{ content_for_layout }}
</main>
<footer class="ft"><div class="wrap">
  <div class="ft-grid">
    <div class="ft-brand">
      <a class="mark" href="{{ routes.root_url }}" aria-label="Fluxcase home">{{ fc_mark }}</a>
      <p>Magnetic cases for 3&nbsp;ML and 10&nbsp;ML vials, made to order in 8 colors.</p>
      {%- unless template.name == 'cart' -%}{%- render 'fc-newsletter' -%}{%- endunless -%}
    </div>
    <nav aria-label="Shop"><h2>Shop</h2><ul>
      <li><a href="/pages/fluxcase-3ml-cases">3&nbsp;ML cases</a></li>
      <li><a href="/pages/fluxcase-10ml-cases">10&nbsp;ML cases</a></li>
      <li><a href="/pages/fluxcase-wholesale">Wholesale and custom</a></li>
      <li><a href="{{ routes.cart_url }}">Cart</a></li>
    </ul></nav>
    <nav aria-label="Company"><h2>Fluxcase</h2><ul>
      <li><a href="/pages/fluxcase-about">About</a></li>
      <li><a href="mailto:help@fluxcases.com">help@fluxcases.com</a></li>
    </ul></nav>
    <nav aria-label="Policies"><h2>Policies</h2><ul>
      <li><a href="/pages/fluxcase-shipping">Shipping</a></li>
      <li><a href="/pages/fluxcase-returns">Returns</a></li>
      <li><a href="/pages/fluxcase-terms">Terms</a></li>
      <li><a href="/pages/fluxcase-privacy">Privacy</a></li>
      <li><a href="/pages/fluxcase-cookies">Cookies</a></li>
      <li><button type="button" class="ft-linkbtn" data-cookie-open>Cookie choices</button></li>
      <li><a href="mailto:help@fluxcases.com?subject=Data%20request">Request or delete your data</a></li>
      <li><a href="/pages/fluxcase-disclaimer">Disclaimer</a></li>
    </ul></nav>
  </div>
  <div class="ft-base"><span>&copy; {{ 'now' | date: '%Y' }} Fluxcase</span><span>Ships within the United States.</span></div>
</div></footer>
{%- render 'fc-cookie' -%}
<script src="{{ 'fluxcase.js' | asset_url }}" defer></script>
<script src="{{ 'fluxcase-b2.js' | asset_url }}" defer></script>
<script src="{{ 'fable2.js' | asset_url }}" defer></script>
</body>
</html>
